# ==============================================================================
# Requirements API - Environment Configuration Example
# ==============================================================================
# IMPORTANT: Copy this file to .env and replace placeholder values
# Never commit .env to version control
# ==============================================================================

# ------------------------------------------------------------------------------
# JWT Authentication Configuration
# ------------------------------------------------------------------------------
# JWT algorithm for token verification (RS256, RS512, HS256, etc.)
JWT_ALGORITHM=RS256

# Option 1: Provide public key directly (base64 or PEM format)
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBg...\n-----END PUBLIC KEY-----"

# Option 2: Provide path to public key file (recommended for Docker)
JWT_PUBLIC_KEY_PATH=/app/certs/public_key.pem

# Optional: Expected issuer (validate 'iss' claim)
# JWT_ISSUER=https://keycloak.example.com/realms/secure-apps

# Optional: Expected audience (validate 'aud' claim)
# JWT_AUDIENCE=requirements

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_PASSWORD_REQUIREMENTS=CHANGE_ME_SECURE_PASSWORD
POSTGRES_USER=app
POSTGRES_DB=reqs
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME_SECURE_PASSWORD@db:5432/reqs

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8921
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Effective-tenant delegation (INBOUND — see src/auth/delegation.py)
# ------------------------------------------------------------------------------
# CSV allowlist of INTROSPECTED subject ids permitted to name the data tenant in
# `X-Effective-Tenant-Id` alongside their own `X-Tenant-Id: Bearer <token>`. This
# is what lets a caller holding ONE credential (e.g. the n8n custom node) keep
# per-request tenant scoping instead of collapsing every call onto the
# credential's own tenant.
#
# ⛔ The subject is taken from the licence INTROSPECTION RESPONSE, never from a
# client header — a caller cannot put itself on this list.
#
# ⚠️ LEAVE EMPTY. Empty is the default and the shipped state: no subject can
# delegate and behaviour is byte-identical to before the feature existed. Arming
# it is a separate, deliberate config change — make it from the evidence in
# `requirements_management_effective_tenant_delegation_rejected_total`, which
# counts exactly the callers that are ready and not yet allowlisted.
AUTH_DELEGATING_SUBJECTS=

# ------------------------------------------------------------------------------
# CORS Configuration (comma-separated origins)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
